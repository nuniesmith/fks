//@version=6
indicator("Ruby", shorttitle="Ruby", overlay=true,
     max_boxes_count=100, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// 0. OPTIMIZER CONSTANTS  ← paste ruby_optimizer.py output block here
//    Defaults below. Python optimizer replaces these with walk-forward
//    optimal values for your symbol + timeframe.
// ══════════════════════════════════════════════════════════════════════════════
var float OPT_VOL_MULT_LO   = 0.80   // vol multiplier at LOW vol
var float OPT_VOL_MULT_MED  = 1.20   // vol multiplier at MED vol
var float OPT_VOL_MULT_HI   = 1.80   // vol multiplier at HIGH vol
var float OPT_QUAL_TREND    = 60.0   // min quality in TRENDING regime
var float OPT_QUAL_RANGE    = 48.0   // min quality in RANGING regime
var float OPT_QUAL_VOLATILE = 44.0   // min quality in VOLATILE regime
var int   OPT_CD_MIN        = 8      // min cooldown bars
var int   OPT_CD_MAX        = 30     // max cooldown bars
var float OPT_TP1_BASE      = 1.5    // TP1 R base
var float OPT_TP2_BASE      = 2.5    // TP2 R base
var float OPT_TP3_BASE      = 4.0    // TP3 R base
var float OPT_RSI_OB_TREND  = 70.0   // RSI OB threshold in trending up
var float OPT_RSI_OB_RANGE  = 63.0   // RSI OB threshold in ranging
var float OPT_RSI_OS_TREND  = 30.0   // RSI OS threshold in trending down
var float OPT_RSI_OS_RANGE  = 37.0   // RSI OS threshold in ranging
var float OPT_WAVE_PCT_L    = 25.0   // wave_ratio percentile gate for longs
var float OPT_WAVE_PCT_S    = 75.0   // wave_ratio percentile gate for shorts
var float OPT_MOM_PCT       = 30.0   // cur_ratio percentile gate

// [FIX] Clamp all optimizer constants to safe ranges every bar.
//       Prevents bad paste values from breaking adaptive thresholds.
OPT_VOL_MULT_LO   := math.max(0.3,              math.min(2.0,   OPT_VOL_MULT_LO))
OPT_VOL_MULT_MED  := math.max(OPT_VOL_MULT_LO,  math.min(3.0,   OPT_VOL_MULT_MED))
OPT_VOL_MULT_HI   := math.max(OPT_VOL_MULT_MED, math.min(5.0,   OPT_VOL_MULT_HI))
OPT_QUAL_TREND    := math.max(0.0,              math.min(100.0,  OPT_QUAL_TREND))
OPT_QUAL_RANGE    := math.max(0.0,              math.min(100.0,  OPT_QUAL_RANGE))
OPT_QUAL_VOLATILE := math.max(0.0,              math.min(100.0,  OPT_QUAL_VOLATILE))
OPT_CD_MIN        := math.max(1,                math.min(99,     OPT_CD_MIN))
OPT_CD_MAX        := math.max(OPT_CD_MIN + 1,   math.min(200,    OPT_CD_MAX))
OPT_TP1_BASE      := math.max(0.5,              math.min(5.0,    OPT_TP1_BASE))
OPT_TP2_BASE      := math.max(OPT_TP1_BASE,     math.min(10.0,   OPT_TP2_BASE))
OPT_TP3_BASE      := math.max(OPT_TP2_BASE,     math.min(20.0,   OPT_TP3_BASE))
OPT_RSI_OB_TREND  := math.max(50.0,             math.min(95.0,   OPT_RSI_OB_TREND))
OPT_RSI_OB_RANGE  := math.max(50.0,             math.min(90.0,   OPT_RSI_OB_RANGE))
OPT_RSI_OS_TREND  := math.max(5.0,              math.min(50.0,   OPT_RSI_OS_TREND))
OPT_RSI_OS_RANGE  := math.max(10.0,             math.min(50.0,   OPT_RSI_OS_RANGE))
OPT_WAVE_PCT_L    := math.max(0.0,              math.min(100.0,  OPT_WAVE_PCT_L))
OPT_WAVE_PCT_S    := math.max(0.0,              math.min(100.0,  OPT_WAVE_PCT_S))
OPT_MOM_PCT       := math.max(0.0,              math.min(100.0,  OPT_MOM_PCT))

// ══════════════════════════════════════════════════════════════════════════════
// 0b. UTILITY FUNCTIONS + EARLY GLOBAL DECLARATIONS
//     Defined here so every subsequent section can use them.
// ══════════════════════════════════════════════════════════════════════════════

// [NEW] f_clamp — safe value bounding; replaces scattered math.max/min chains
f_clamp(v, lo, hi) => math.max(lo, math.min(hi, v))

// [FIX] f_pct — percentile helper.
//       Original had integer division bug: cnt/n always rounded to 0 when
//       cnt < n.  Fixed to float(cnt)/float(n).
f_pct(arr, val) =>
    n = array.size(arr)
    if n == 0
        0.5
    else
        cnt = 0
        for i = 0 to n - 1
            if array.get(arr, i) < val
                cnt += 1
        float(cnt) / float(n)

// [NEW] Label pruning pool — auto-deletes oldest labels when the pool
//       exceeds MAX_LBL_POOL, preventing max_labels_count=500 exhaustion.
var array<label> label_pool   = array.new<label>()
int              MAX_LBL_POOL = 450   // leave headroom below the 500 ceiling

f_label_new(lx, ly, ltxt, lcol, lsty, ltcol, ltsz) =>
    lbl = label.new(lx, ly, ltxt, color=lcol, style=lsty, textcolor=ltcol, size=ltsz)
    array.push(label_pool, lbl)
    if array.size(label_pool) > MAX_LBL_POOL
        label.delete(array.shift(label_pool))
    lbl
