// ── Module: top_g_channel ───────────────────────────────────────────────────
// Part of the Ruby indicator — assembled by PineScriptGenerator

// ══════════════════════════════════════════════════════════════════════════════
// 3. TOP G CHANNEL
// ══════════════════════════════════════════════════════════════════════════════
tg_lo    = ta.lowest (low,  topGLen)
tg_hi    = ta.highest(high, topGLen)
tg_mid   = ta.hma(math.avg(tg_lo, tg_hi), 15)
tg_range = tg_hi - tg_lo

// Normalised rate-of-change for momentum confirmation
roc8     = ta.roc(close, 8)
roc8_std = ta.stdev(roc8, 200)
roc_norm = roc8_std > 0 ? roc8 / roc8_std : 0.0

// ATR-scaled proximity tolerance — one sigSens knob controls both TG and momentum gates
_tg_prox = atr14 * 0.2 * sigSens

// ── Strong signals (entry-grade) ─────────────────────────────────────────────
// Strong bounce: two consecutive bars within proximity of channel low + momentum exhaustion
// [FIX] Replaces exact low == tg_lo equality with a proximity band so the signal
//       fires even when price doesn't print the absolute channel low to the tick.
strong_bot = low[1]  <= tg_lo[1] + _tg_prox and low  > tg_lo[1] and
             low[2]  <= tg_lo[2] + _tg_prox and
             roc_norm[2] < -2 * sigSens and barstate.isconfirmed

// Strong rejection: two consecutive bars within proximity of channel high + momentum exhaustion
// [FIX] Replaces exact high == tg_hi equality; flat-support condition uses
//       math.abs() tolerance instead of == for the same reason.
strong_top = high[1] >= tg_hi[1] - _tg_prox and high < tg_hi[1] and
             roc_norm[2] > 2 * sigSens and
             math.abs(tg_lo - tg_lo[5]) <= _tg_prox and barstate.isconfirmed

// ── Simple signals (visual marker only — NOT an entry) ──────────────────────
simple_bot = low[1]  <= tg_lo[1] + _tg_prox and low  > tg_lo[1] and not strong_bot and barstate.isconfirmed
simple_top = high[1] >= tg_hi[1] - _tg_prox and high < tg_hi[1] and not strong_top and barstate.isconfirmed

// ── Potential / early-warning — price entering channel zone with momentum ────
bool pot_bot = low  <= tg_lo + atr14 * 0.5 and roc_norm < -1 * sigSens and barstate.isconfirmed
bool pot_top = high >= tg_hi - atr14 * 0.5 and roc_norm >  1 * sigSens and barstate.isconfirmed
