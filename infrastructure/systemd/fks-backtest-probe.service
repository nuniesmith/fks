[Unit]
Description=FKS edge-factory backtest-run probe (verdict freshness + failure streak)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# node-exporter (fks compose) mounts /var/lib/node_exporter/textfile. The
# metric write is skipped, never fatal, until that folder is writable by
# this user: sudo chown "$USER" /var/lib/node_exporter/textfile
Environment=FKS_TEXTFILE_DIR=/var/lib/node_exporter/textfile
ExecStart=/home/jordan/github/fks/scripts/backtest-runs-probe.sh
