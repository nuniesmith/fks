// ── Module: trade_management ────────────────────────────────────────────────
// Part of the Ruby indicator — assembled by PineScriptGenerator

// ══════════════════════════════════════════════════════════════════════════════
// 11. ENTRY · DYNAMIC SL · TP · SCALE-IN
// SL = adaptive: wider in high-vol, anchored to sweep low/high + ATR buffer
// Risk floor = 0.5 × ATR14 so micro-wicks never produce near-zero risk
// TP levels are momentum-scaled multiples of 1R (computed in §7)
// E2 / E3 = scale-in pullback entries at scaleInR fractions of 1R
// ══════════════════════════════════════════════════════════════════════════════

// ── Dynamic SL multiplier — widens with vol percentile ───────────────────────
float _sl_base_mult = vol_pct >= 0.75 ? 2.0 :
                      vol_pct >= 0.55 ? 1.7 :
                      vol_pct >= 0.35 ? 1.4 : 1.2

// ── Optional extra widening on volume surges (stop-hunt protection) ───────────
float _vol_surge = slVolBoost and volume > volAvg * 2.5 ? 0.5 :
                   slVolBoost and volume > volAvg * 1.8 ? 0.25 : 0.0

float _sl_mult = _sl_base_mult + _vol_surge

// ── Sweep lookback — recent extreme wick for stop placement ──────────────────
float _sweep_lo = ta.lowest (low,  sweepBars)
float _sweep_hi = ta.highest(high, sweepBars)

// ── Long levels ──────────────────────────────────────────────────────────────
l_entry = close
l_sl    = dynSL
     ? math.min(_sweep_lo, close - atr14 * _sl_mult) - atr14 * 0.25
     : low - atr14
// [FIX] Risk floor — prevents near-zero risk from micro-wick SL placement
l_risk  = math.max(l_entry - l_sl, atr14 * 0.5)
l_tp1   = l_entry + l_risk * tp1R
l_tp2   = l_entry + l_risk * tp2R
l_tp3   = l_entry + l_risk * tp3R
// Scale-in pullback entries — E2 = 1st add, E3 = 2nd add
l_e2    = l_entry - l_risk * scaleInR
l_e3    = l_entry - l_risk * scaleInR * 2.0

// ── Short levels ─────────────────────────────────────────────────────────────
s_entry = close
s_sl    = dynSL
     ? math.max(_sweep_hi, close + atr14 * _sl_mult) + atr14 * 0.25
     : high + atr14
// [FIX] Risk floor — mirrors long side
s_risk  = math.max(s_sl - s_entry, atr14 * 0.5)
s_tp1   = s_entry - s_risk * tp1R
s_tp2   = s_entry - s_risk * tp2R
s_tp3   = s_entry - s_risk * tp3R
// Scale-in pullback entries — E2 = 1st add, E3 = 2nd add
s_e2    = s_entry + s_risk * scaleInR
s_e3    = s_entry + s_risk * scaleInR * 2.0
