logs/
!logs/.gitkeep
!logs/*/.gitkeep
*.log
trace/
debug/
*.trc

# ============================================================================
# Temporary & Backup Files
# ============================================================================

src_backup/
*.bak
*.orig
*.tmp
*.temp
tmp/
temp/
.tmp/

# ============================================================================
# Data & Databases
# ============================================================================

*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.csv
*.parquet
/data/
data/*.db
data/*.db-*
data/experiments/
data/parquet/
data/backups/
/backups/
dataset/
projects/
outputs/
results/

# ============================================================================
# ML / Models
# ============================================================================

# Ignore all large model binaries by extension
*.pt
*.pth
*.h5
*.hdf5
*.pb
*.onnx
*.ort
*.pkl
*.pickle
*.ckpt
*.safetensors
*.bin
*.model

# Allow model directory structure & champion files
!models/
!models/**
models/archive/
!models/.gitkeep
!models/breakout_cnn_best.pt
!models/breakout_cnn_best_meta.json
!models/feature_contract.json

model_registry/

# ML caches
.fastembed_cache/
.ort_cache/
ort_cache/

# ============================================================================
# Test Coverage
# ============================================================================

*.profraw
*.profdata
coverage/

# ============================================================================
# Project-specific
# ============================================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
.env.secrets
.env.*.secrets
!.env.example
!.env.template

secrets/
*.key
*.pem
*.crt
!**/ssl/*.crt.example

# --- Reports & Workspace ---
reports/
workspace/

# --- Images (generated charts / screenshots) ---
*.png

# --- Build & Deploy Artifacts ---
releases/
build/output/
build/temp/
temp_build/
packages/*.zip
/config-output/
/workflow-env/

# --- Analysis & Reports ---
file_contents.txt
codebase_summary.md
codebase_analysis_report_*/
codebase-analysis-report*/
analysis_report_*/
perf.json
format-report.json
**/format-report.json

# --- Documentation (auto-generated) ---
docs/api/
docs/audit/reports/
site/
target/doc/
book/

# --- Audit Cache ---
.audit-cache/

# --- Source Caches ---
.cache/
src/**/cache/
src/**/*.cache
src/**/*.meta

# --- Nginx SSL (keep examples) ---
nginx/ssl/*.crt
nginx/ssl/*.key
!nginx/ssl/*.example

# --- TLS certificates (generated by scripts/generate-certs.sh) ---
!infrastructure/certs/
infrastructure/certs/ca.crt
infrastructure/certs/ca.key
infrastructure/certs/server.crt
infrastructure/certs/server.csr
infrastructure/certs/server.key

# --- Infrastructure Configs (generated at deploy) ---
infrastructure/config/certbot/cloudflare.ini
infrastructure/config/alertmanager/alertmanager.yml
config/certbot/*.ini
config/certbot/*.json
!config/certbot/*.example
config/authelia/notification.txt

# --- Misc ---
.local
.stfolder/
futures_journal.db

# --- Archives ---
*.zip
*.tar.gz
*.rar

# --- fks-state: private backup/import (scripts/fks-state.sh) ---
# Only the .example template + the tool are public; the real manifest, age
# keys, and any encrypted snapshot that lands here stay out of the repo.
state.manifest
*.age
.fks-state-stage/

# --- Bot configs: only the *.example.toml templates are tracked ---
# The operator's tuned spot config (mirrors the crypto repo's .gitignore). The
# Docker build globs it in when it sits next to the example; it must never be
# committed.
bots/spot-portfolio/spot-portfolio.toml

# ============================================================================
# Keep Empty Directories
# ============================================================================

!packages/.gitkeep
!build/.gitkeep
!docs/.gitkeep
