// ── Module: volatility ──────────────────────────────────────────────────────
// Part of the Ruby indicator — assembled by PineScriptGenerator

// ══════════════════════════════════════════════════════════════════════════════
// 6. VOLATILITY PERCENTILE
// [FIX] Eliminated duplicated manual O(n) loop — now calls f_pct() from §0b.
//       Also fixed push()+shift() O(1) pattern (was unshift() O(n)).
//       Integer-division bug fixed inside f_pct() itself.
// ══════════════════════════════════════════════════════════════════════════════
var array<float> vol_arr = array.new<float>(200, 0.0)

if barstate.isconfirmed
    array.push(vol_arr, nz(atr14, 0.0))
    if array.size(vol_arr) > 200
        array.shift(vol_arr)

// [FIX] Single call to f_pct — consistent with §4 percentile logic
float vol_pct = f_pct(vol_arr, nz(atr14, 0.0))

vol_regime = vol_pct >= 0.8 ? "VERY HIGH" :
             vol_pct >= 0.6 ? "HIGH"      :
             vol_pct <= 0.2 ? "VERY LOW"  :
             vol_pct <= 0.4 ? "LOW"       : "MED"
