[Unit]
Description=FKS ORB briefing dead-man probe (emit next-due/last-send gauges for Prometheus)
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=FKS_TEXTFILE_DIR=/home/jordan/.local/share/node_exporter/textfile
ExecStart=/home/jordan/github/fks/scripts/orb-briefing-deadman.sh
