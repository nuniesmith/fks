# =============================================================================
# state.manifest — what `scripts/fks-state.sh export` bundles into an encrypted
# snapshot. Copy to `state.manifest` (gitignored) and tune to your deployment.
#
# Lines are either:
#   • a file or glob, relative to the repo root  (e.g. .env, models/*.bin)
#   • db:<database>[:table1,table2,...]           dumped via the postgres container
# Blank lines and #-comments are ignored. Missing file matches are skipped with
# a warning, so it's safe to list paths you don't always have.
#
# NOTHING here should ever be committed to the public repo — this manifest only
# names the private surface; the snapshot itself lives in the private fks-state
# repo, age-encrypted.
# =============================================================================

# ── Secrets & TLS ────────────────────────────────────────────────────────────
.env
.env.secrets
infrastructure/certs/

# ── Strategy configs — the edge (the bot repos' tuned params) ────────────────
# These live in the bot repos; symlink or copy them here, or point at them
# directly if checked out alongside fks-full. Uncomment what applies:
# ../crypto/funding.toml
# ../crypto/spot-portfolio.toml
# ../dip/.env

# ── Model weights / optimizer + backtest output ──────────────────────────────
models/*.bin
models/*.safetensors
models/*.pt
models/*.onnx

# ── Live file-state (journals, open positions) ───────────────────────────────
# Bot working state that must survive a redeploy. Adjust to your layout:
# ../crypto/funding-paper.jsonl
# ../crypto/funding-state-*.json
# ../crypto/spot-trades.jsonl

# ── Database tables — the runtime secret store + account/PnL state ───────────
# Dumped data-only (schema lives in src/sql/, applied at container init).
db:ruby_db:exchange_secrets
db:janus_db:api_keys,api_key_audit
# Add account / position / pnl tables as your schema grows, e.g.:
# db:ruby_db:bot_configs,bot_runs
