// ── Module: adaptive_thresholds ─────────────────────────────────────────────
// Part of the Ruby indicator — assembled by PineScriptGenerator

// ══════════════════════════════════════════════════════════════════════════════
// 7. ADAPTIVE THRESHOLDS  — all derived, no user inputs needed
//    Optimizer constants (§0) feed into each threshold so walk-forward
//    calibration tightens or loosens every gate simultaneously.
// ══════════════════════════════════════════════════════════════════════════════

// ── Volume spike threshold ────────────────────────────────────────────────────
// Scales with the current volatility regime: low vol → loose gate,
// high vol → tight gate (avoid chasing expanded moves).
float volMult = vol_pct >= 0.6 ? OPT_VOL_MULT_HI :
                vol_pct >= 0.4 ? OPT_VOL_MULT_MED : OPT_VOL_MULT_LO

// ── Quality threshold ─────────────────────────────────────────────────────────
// Trending markets require higher conviction; volatile / ranging markets
// accept a lower bar so noise doesn't completely suppress signals.
float minQualityPct = is_trending ? OPT_QUAL_TREND :
                      is_volatile ? OPT_QUAL_VOLATILE : OPT_QUAL_RANGE

// ── Dynamic cooldown ──────────────────────────────────────────────────────────
// Interpolates between OPT_CD_MIN (calm) and OPT_CD_MAX (high vol) so
// the indicator self-throttles when the market is churning.
int cooldownBars = math.round(OPT_CD_MIN + (OPT_CD_MAX - OPT_CD_MIN) * vol_pct)

// ── RSI overbought / oversold thresholds ─────────────────────────────────────
// Trending markets allow higher RSI for longs / lower RSI for shorts
// before the filter kicks in; ranging markets are tighter.
float rsiOBLevel = is_trending_u ? OPT_RSI_OB_TREND : OPT_RSI_OB_RANGE
float rsiOSLevel = is_trending_d ? OPT_RSI_OS_TREND : OPT_RSI_OS_RANGE

// ── Wave ratio gates ──────────────────────────────────────────────────────────
// Long signals require wave_ratio in the upper OPT_WAVE_PCT_L percentile;
// short signals require it in the lower (1 - OPT_WAVE_PCT_S) percentile.
// sigSens scales the gate: lower sensitivity → easier to pass.
bool waveOK_L = wr_pct  >= (OPT_WAVE_PCT_L / 100.0) * sigSens
bool waveOK_S = wr_pct  <= 1.0 - (OPT_WAVE_PCT_S / 100.0) * sigSens

// ── Momentum gates ────────────────────────────────────────────────────────────
// cur_ratio must be directionally aligned AND in the upper OPT_MOM_PCT
// percentile of historical momentum readings.
bool momOK_L = mom_pct >= (OPT_MOM_PCT / 100.0) * sigSens and cur_ratio > 0
bool momOK_S = mom_pct >= (OPT_MOM_PCT / 100.0) * sigSens and cur_ratio < 0

// ── TP multiples ──────────────────────────────────────────────────────────────
// Base multiples from optimizer are scaled by:
//   1. Momentum strength  — strong momentum → wider targets
//   2. sigSens            — sensitivity knob shifts targets proportionally
float _tp_mom_scale = math.abs(cur_ratio) >= 1.5 ? 1.25 :
                      math.abs(cur_ratio) >= 1.0 ? 1.0  :
                      math.abs(cur_ratio) >= 0.6 ? 0.85 : 0.7
float _tp_scale = _tp_mom_scale * (0.7 + sigSens * 0.6)

float tp1R = OPT_TP1_BASE * _tp_scale
float tp2R = OPT_TP2_BASE * _tp_scale
float tp3R = OPT_TP3_BASE * _tp_scale

// ── Trailing stop ATR multiple ────────────────────────────────────────────────
// Widens the trailing stop buffer in high-vol environments so normal
// candle noise does not stop out a valid trend prematurely.
float trailATRMult = 1.0 + vol_pct

// ── Scale-in pullback fraction ────────────────────────────────────────────────
// How far back from entry E2 / E3 scale-in levels are placed,
// expressed as a fraction of 1R.  Trending markets allow a shallower
// pullback; ranging markets expect deeper mean-reversion.
float scaleInR = is_trending ? 0.25 : is_ranging ? 0.4 : 0.33
