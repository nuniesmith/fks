# bots/crypto-regime.yaml.disabled
# Kraken spot regime bot (200-day MA rule) — folded in from the standalone
# crypto-bot-live container. Runs LIVE, mirroring the current Kraken setup.
#
# DISABLED 2026-10-15 — `autostart: false` below. The cutover in
# docs/ORYX.md never stopped the standalone, so this bot and crypto-bot-live
# both traded the same Kraken account for four days: both invested the
# 2026-10-14 USDC deposit (an extra ~$18 of BTC). The standalone on oryx is
# the live trader until the cutover is done IN ORDER. While disabled, do not
# respawn it from the UI: the image always trades live, whatever `mode` says.
#
# RENAMED 2026-10-22 so botsync skips it. botsync globs *.yaml and *.yml,
# and its upsert sets is_active, so under a .yaml name every deploy
# re-created an active, startable config: `autostart: false` stops only
# botsync itself from starting it. Give the file its .yaml name back only
# at the cutover (EDGE_FACTORY_PLAN §6.4), once account leases exist.
#
# Synced into the spawner by botsync (POST /configs, upsert by `name`).
# To add a bot: drop another YAML file here and `up -d` (or POST /configs).
name: crypto-regime
description: "Kraken spot regime bot (200-day MA rule) — folded in from standalone, LIVE"
image: ghcr.io/nuniesmith/crypto:latest
mode: live
bot_id: crypto-regime
cpu_limit: 1.0
memory_mb: 512
env:
  # Bot state (state.json) + journal land in the spawner's per-bot volume.
  CRYPTO_BOT_ROOT: /var/lib/fks-bot
  # Templated by botsync from the deploy environment — never committed.
  CRYPTO_DISCORD_WEBHOOK_URL: ""
  TZ: America/Toronto
# Injected at spawn from the spawner's encrypted secret store.
# Spawn FAILS if `kraken` has no stored credentials (never a keyless live bot).
secrets:
  - kraken
restart_policy:
  enabled: true
  max_restarts: 3
  window_secs: 3600
# botsync respawns it if not running after a sync. Off: see the header.
autostart: false
