graph TD
%% Neuromorphic Architecture - JANUS Trading System
%% This diagram maps the trading system to biological brain regions
%% Generated by: audit-cli visualize

%% Style Definitions
classDef sensory fill:#f9f,stroke:#333,stroke-width:2px,color:black;
classDef executive fill:#bbf,stroke:#333,stroke-width:2px,color:black;
classDef memory fill:#bfb,stroke:#333,stroke-width:2px,color:black;
classDef limbic fill:#fbb,stroke:#333,stroke-width:2px,color:black;
classDef action fill:#ddd,stroke:#333,stroke-width:4px,color:black;
classDef output fill:#fb9,stroke:#333,stroke-width:2px,color:black;
classDef meta fill:#eee,stroke:#333,stroke-dasharray:5 5,color:black;

%% Brain Regions (Subgraphs)

subgraph Sensory
    SENSORY['External Data Feeds<br/>WebSocket: Binance, Bybit']
    DSP['Signal Processing (DSP)<br/>Filters, Normalization']
    THALAMUS['Thalamus (TRN Gating)<br/>Noise Filter, Attention']
end

subgraph Memory
    HIPPOCAMPUS['Hippocampus (Time Cells/SR)<br/>State Encoding, Prediction']
end

subgraph Executive
    CORTEX['Cortex (Strategy/Planning)<br/>Pattern Recognition']
    PFC['Prefrontal (Working Memory)<br/>Context Maintenance']
    CEREBELLUM['Cerebellum (Error Correction)<br/>Execution Optimization']
end

subgraph Limbic
    AMYGDALA['Amygdala (Fear/Risk Veto)<br/>Kill Switch, Loss Aversion']
    HYPOTHALAMUS['Hypothalamus (Homeostasis/Kelly)<br/>Risk Management']
end

subgraph Action
    BG['Basal Ganglia (Go/NoGo)<br/>Direct/Indirect Pathways']
end

subgraph Output
    MOTOR['Motor Cortex (Execution)<br/>Order Placement']
    CLIENTS['Frontend (Visualization)<br/>Dashboard, Monitoring']
end

subgraph Meta
    AUDIT['LLM Audit (Meta-Cognition)<br/>Performance Analysis']
end

%% Data Flow Connections (The "Connectome")

%% Path A: Exteroception (Thinking Loop)
SENSORY -->|Raw Market Data| DSP
DSP -->|Cleaned Signal| THALAMUS
THALAMUS -->|State Encoding<br/>Grid Cells| HIPPOCAMPUS
THALAMUS -->|Fast Threat<br/>Detection| AMYGDALA
THALAMUS -->|Bursts/<br/>Attention| CORTEX

%% Memory & Context
HIPPOCAMPUS -->|Successor<br/>Representation| PFC
HIPPOCAMPUS -->|Context<br/>State| BG

%% Executive Control
PFC -->|Strategy<br/>Selection| BG
CORTEX -->|Action<br/>Proposals| BG
CEREBELLUM -->|Fine Tuning<br/>Almgren-Chriss| MOTOR

%% Path B: Limbic Regulation (Risk)
HYPOTHALAMUS -->|Risk Appetite<br/>Kelly Criterion| AMYGDALA
AMYGDALA -->|Inhibition<br/>NoGo/Fear| BG
HYPOTHALAMUS -->|Motivation<br/>Dopamine| BG

%% Path C: Action & Output
BG -->|Gated<br/>Execution| MOTOR
MOTOR -->|Trade<br/>Updates| CLIENTS

%% Meta-Learning Loop
MOTOR -->|Post-Trade<br/>Logs| AUDIT
AUDIT -->|Policy Updates<br/>Meta-Learning| CORTEX

%% Apply Styles
class SENSORY,DSP,THALAMUS sensory
class HIPPOCAMPUS memory
class CORTEX,PFC,CEREBELLUM executive
class AMYGDALA,HYPOTHALAMUS limbic
class BG action
class MOTOR,CLIENTS output
class AUDIT meta
