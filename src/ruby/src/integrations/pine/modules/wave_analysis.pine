// ── Module: wave_analysis ───────────────────────────────────────────────────
// Part of the Ruby indicator — assembled by PineScriptGenerator

// ══════════════════════════════════════════════════════════════════════════════
// 4. WAVE ANALYSIS
// [FIX] array.unshift() (O(n) on every crossing) replaced with
//       push() + shift() which is O(1) amortised — same semantic effect.
// ══════════════════════════════════════════════════════════════════════════════
dyn_ema = ta.ema(close, 20)

var float speed = 0.0
c_rma = ta.rma(close, 10)
o_rma = ta.rma(open,  10)

var int              wx1        = na
var array<float> bull_waves = array.new<float>()
var array<float> bear_waves = array.new<float>()

if na(wx1)
    wx1 := bar_index

int   wave_lkbk = math.max(1, bar_index - nz(wx1, bar_index))
float speed_lo  = ta.lowest( speed, wave_lkbk)
float speed_hi  = ta.highest(speed, wave_lkbk)

// [FIX] push()+shift() instead of unshift()
if close > dyn_ema and close[1] <= dyn_ema
    array.push(bear_waves, speed_lo)
    if array.size(bear_waves) > 200
        array.shift(bear_waves)
    wx1   := bar_index
    speed := c_rma - o_rma

if close < dyn_ema and close[1] >= dyn_ema
    array.push(bull_waves, speed_hi)
    if array.size(bull_waves) > 200
        array.shift(bull_waves)
    wx1   := bar_index
    speed := c_rma - o_rma

speed      := speed + (c_rma - o_rma)
trendspeed  = ta.hma(speed, 5)

var float  wave_ratio = 1.0
var float  dom_val    = 0.0
var string mkt_bias   = "Neutral"
var float  bull_avg   = 0.0001
var float  bear_avg_v = 0.0001

if barstate.isconfirmed
    if array.size(bull_waves) > 0
        bull_avg := array.avg(bull_waves)
    if array.size(bear_waves) > 0
        bear_avg_v := math.abs(array.avg(bear_waves))
    wave_ratio := bear_avg_v == 0 ? 1.0 : bull_avg / bear_avg_v
    dom_val    := bull_avg - bear_avg_v
    mkt_bias   := dom_val > 0 ? "Bullish" : dom_val < 0 ? "Bearish" : "Neutral"

cur_ratio = speed > 0
     ? (bull_avg   > 0 ? speed           / bull_avg   :  1.0)
     : (bear_avg_v > 0 ? math.abs(speed) / bear_avg_v * -1.0 : -1.0)

// ── Rolling percentile arrays for adaptive gates ─────────────────────────────
// [FIX] push()+shift() instead of unshift()
var array<float> wr_arr  = array.new<float>(200, 1.0)
var array<float> mom_arr = array.new<float>(200, 0.5)

if barstate.isconfirmed
    array.push(wr_arr,  nz(wave_ratio, 1.0))
    array.push(mom_arr, nz(math.abs(cur_ratio), 0.5))
    if array.size(wr_arr)  > 200
        array.shift(wr_arr)
    if array.size(mom_arr) > 200
        array.shift(mom_arr)

// Compute live percentiles against confirmed history — correct because
// arrays only update on confirmed bars but we query on every tick
float wr_pct  = f_pct(wr_arr,  nz(wave_ratio, 1.0))
float mom_pct = f_pct(mom_arr, nz(math.abs(cur_ratio), 0.5))
