# ML / Models
# ============================================================================

# Ignore all large model binaries by extension
*.pt
*.pth
*.h5
*.hdf5
*.pb
*.onnx
*.ort
*.pkl
*.pickle
*.ckpt
*.safetensors
*.bin
*.model

# Allow model directory structure & champion files
!models/
!models/**
models/archive/
!models/.gitkeep
!models/breakout_cnn_best.pt
!models/breakout_cnn_best_meta.json
!models/feature_contract.json

model_registry/

# ML caches
.fastembed_cache/
.ort_cache/
ort_cache/

