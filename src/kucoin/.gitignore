*.pdb

# sqlx offline query cache — generated by `cargo sqlx prepare`.
# The codebase uses dynamic query() calls only, so this directory is never
# populated and should not be tracked.
.sqlx/

# NOTE: Cargo.lock is intentionally NOT ignored — this is a binary project.

