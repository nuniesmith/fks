# =============================================================================
# JANUS — Rust ML / neuromorphic trading engine
# HTTP API: port 7000 (host) / 8080 (container)
# gRPC:     port 9051 (host) / 50051 (container)
# =============================================================================

# --- Execution mode ---
EXECUTION_MODE=paper_trading
EXEC_ACCOUNT_TYPE=personal-crypto

# --- Market data ingestion ---
DATA_SOURCE=live
DATA_EXCHANGE=binance
DATA_WS_URL=wss://stream.binance.com:9443/ws
DATA_KLINE_INTERVALS=1m,5m
DATA_RECONNECT_DELAY_SECS=5
DATA_MAX_RECONNECT_ATTEMPTS=50
DATA_HEALTH_POLL_SECS=10
# Persist closed klines → QuestDB candles_crypto (the WebUI chart history
# source). On by default; set false to disable the sink.
DATA_PERSIST_CANDLES=true

# --- Brain / watchdog ---
BRAIN_WIRE_KILL_SWITCH=false
BRAIN_AUTO_START_WATCHDOG=true
BRAIN_HEARTBEAT_MS=5000
BRAIN_WATCHDOG_CHECK_INTERVAL_MS=5000
BRAIN_WATCHDOG_DEAD_THRESHOLD=10

# --- Execution gate (janus brain → broker) ---
# NEVER autonomous: signals terminate at a human decision point. Keep
# ENABLE_EXECUTION=false unless you fully understand the live order path.
JANUS_ENABLE_BACKWARD=true
ENABLE_EXECUTION=true
# Portfolio risk enforcement (janus forward). Defaults ON in compose: a
# RiskManager rejection (over-exposure / daily-loss / max-position) blocks the
# order submit. Set to 0 only to make risk checks advisory — not recommended
# when ENABLE_EXECUTION=true.
JANUS_RISK_ENFORCE=1
# EXECUTION_ENDPOINT defaults (in compose) to the janus-execution gRPC service.
EXECUTION_EXCHANGE=kraken
EXECUTION_CONNECT_TIMEOUT=10
EXECUTION_REQUEST_TIMEOUT=30
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_BACKOFF_MS=100
EXECUTION_DEFAULT_QUANTITY=0.001

# --- Alertmanager integration (Janus pushes trade-signal alerts) ---
