# ============================================================================
# FKS Trading Platform — .gitignore
# ============================================================================

# ============================================================================
# OS
# ============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride

# Windows
ehthumbs.db
Thumbs.db
desktop.ini

# Linux
*~

# ============================================================================
# IDE / Editors
# ============================================================================

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# JetBrains (IntelliJ, Android Studio, Fleet)
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.userprefs

# Eclipse
.classpath
.project
.settings/

# Vim / Emacs
*.swp
*.swo
.*.swp

# Sublime Text
*.sublime-*

# Cursor
.cursor/

# Claude
.claude/

# ============================================================================
# Rust
# ============================================================================

target/
**/target/
**/*.rs.bk
*.rlib
*.pdb

# sqlx offline query cache — generated by `cargo sqlx prepare`.
# The codebase uses dynamic query() calls only, so this directory is never
# populated and should not be tracked.
.sqlx/

# NOTE: Cargo.lock is intentionally NOT ignored — this is a binary project.

# ============================================================================
# Python
# ============================================================================

.venv/
venv/
ENV/
.Python

__pycache__/
*.py[cod]
*.pyo
*.pyd

*.egg
*.egg-info/
.eggs/
*.whl
dist/

.mypy_cache/
**/.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ============================================================================
# Kotlin / Gradle / KMP
# ============================================================================

# Gradle
.gradle/
**/.gradle/
.gradletasknamecache
gradle-app.setting
local.properties

# Gradle wrapper jar MUST be checked in (exception to *.jar below)
!gradle/wrapper/gradle-wrapper.jar
!gradle-wrapper.jar
!gradle-wrapper.properties

# Build directories
build/
**/build/
out/
**/out/

# Compiled classes & JVM artifacts
*.class
**/classes/
*.jar
*.war
*.ear

# Kotlin / JS build outputs
**/build/**/kotlin/
**/build/**/*.js
**/build/**/*.js.map
**/js/packages/
**/compileSync/
**/compileKotlinJs/
**/kotlin-js-store/

# Kotlin Native metadata
*.knm
*.kotlin_module
**/linkdata/
**/build/**/linkdata/

# Kotlin caches
**/build/**/*.s
**/caches-*/
**/ir-translation-result.tab.*

# ============================================================================
# Android
# ============================================================================

*.apk
*.ap_
*.aab
*.dex
# Android generated sources (scoped to avoid shadowing Buf/proto gen/)
**/android/**/gen/
proguard/
captures/
.externalNativeBuild
.cxx/
**/android/build/
**/android/app/build/
**/android/.cxx/

