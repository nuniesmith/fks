// ── Module: session_orb ─────────────────────────────────────────────────────
// Part of the Ruby indicator — assembled by PineScriptGenerator

// ══════════════════════════════════════════════════════════════════════════════
// 8. SESSION BIAS + ORB
// [FIX] pdHigh/pdLow: use request.security("D", high[1]/low[1]) — the old
//       approach used high[1]/low[1] bar-index which was the *previous bar's*
//       value, not the prior *day's* value.
// [FIX] orbBreakUp/orbBreakDn gated on barstate.isconfirmed — eliminates
//       intrabar firing that caused label flicker and phantom alerts.
// [FIX] IB resets on sessionStart (RTH open detection) not newDay.
//       On an equities chart, calendar midnight ≠ market open.
// ══════════════════════════════════════════════════════════════════════════════
newDay = ta.change(time("D")) != 0
inRTH  = not useSession or not na(time("1", sessionHours))

// [FIX] Detect first bar of RTH session; fall back to newDay for 24/7 assets.
//       bar_index guard prevents na-access on bar 0.
bool _inRTH_prev  = bar_index > 0 ? inRTH[1] : inRTH
bool sessionStart = (inRTH and not _inRTH_prev) or (newDay and not useSession)

htTrend = request.security(syminfo.tickerid, htfTF,
     close > ta.ema(close, 9) ? 1 : -1, lookahead=barmerge.lookahead_off)

// [NEW] HTF Awesome Oscillator for optional confirmation filter
htf_ao = request.security(syminfo.tickerid, htfTF, ao, lookahead=barmerge.lookahead_off)

bullBias = biasMode == "Long Only" or
           (biasMode == "Auto" and
            (close > vwap ? 1 : 0) + (ao > 0 ? 1 : 0) + (htTrend == 1 ? 1 : 0) >= 2)

// [FIX] Prior-day high/low via request.security — correct prior-day values
//       on any timeframe, without relying on bar_index arithmetic.
pdHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdLow  = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)

// ── ORB ──────────────────────────────────────────────────────────────────────
var float rHigh      = na
var float rLow       = na
var bool  rangeReady = false

bool cross_hi = ta.crossover (high, nz(rHigh))
bool cross_lo = ta.crossunder(low,  nz(rLow))

if newDay
    rHigh      := na
    rLow       := na
    rangeReady := false

int barsSinceOpen = ta.barssince(newDay)
if barsSinceOpen * timeframe.multiplier <= orbMinutes and inRTH
    rHigh := math.max(nz(rHigh, high), high)
    rLow  := math.min(nz(rLow,  low),  low)
else if not rangeReady and not na(rHigh)
    rangeReady := true

// [FIX] barstate.isconfirmed prevents intrabar crossovers from triggering
//       labels, lines, and tracker entries that would be recreated on
//       every tick until the bar closes.
orbBreakUp = rangeReady and cross_hi and     bullBias and barstate.isconfirmed
orbBreakDn = rangeReady and cross_lo and not bullBias and barstate.isconfirmed

// [NEW] ORB window via user input + chart timezone — replaces hardcoded
//       "0930-1000" / "0300-0330" / "1800-1830" multi-session block.
bool orbWindow = not na(time("1", orbWindowSession, syminfo.timezone))

// ── Initial Balance ───────────────────────────────────────────────────────────
var float ibHigh = na
var float ibLow  = na
var int   ibBars = 0
var bool  ibDone = false

// [FIX] Reset IB on sessionStart (RTH open), not newDay.
//       For equities: RTH open = 09:30, not midnight.  For 24/7: equivalent to newDay.
if sessionStart
    ibHigh := high
    ibLow  := low
    ibBars := 0
    ibDone := false

if not ibDone and inRTH
    ibBars += 1
    ibHigh := math.max(ibHigh, high)
    ibLow  := math.min(ibLow,  low)
    if ibBars * timeframe.multiplier >= ibMinutes and barstate.isconfirmed
        ibDone := true

// ── Squeeze Detection ─────────────────────────────────────────────────────────
bb_u = ta.sma(close, 20) + 2.0 * ta.stdev(close, 20)
bb_l = ta.sma(close, 20) - 2.0 * ta.stdev(close, 20)
kc_u = ta.sma(close, 20) + ta.atr(20) * 1.5
kc_l = ta.sma(close, 20) - ta.atr(20) * 1.5
sqz_on    = bb_l > kc_l and bb_u < kc_u
sqz_fired = sqz_on[1] and not sqz_on
