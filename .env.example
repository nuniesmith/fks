# =============================================================================
# FKS Trading System — Environment Variables
# Copy to .env and fill in your values.
#
#   cp .env.example .env
#
# Generate secrets with:
#   openssl rand -base64 32   # for passwords / session secrets
#   openssl rand -hex 32      # for tokens / API keys
#
# Or use the helper script:
#   ./run.sh setup-env
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  SECRET MANAGEMENT PHILOSOPHY                                          │
# │                                                                        │
# │  • SERVICE SECRETS (Postgres, Redis, Grafana, session keys, etc.)      │
# │    → Auto-generated by ./run.sh setup-env — never leave the server.    │
# │    → Stored ONLY in .env — never committed to git.                     │
# │                                                                        │
# │  • EXTERNAL API KEYS (Kraken, Rithmic, Massive, xAI, TV, etc.)        │
# │    → Stored encrypted in Postgres via Settings → API Keys in WebUI.    │
# │    → key_manager resolves: encrypted DB → env var → None (graceful).   │
# │    → Env vars below are fallbacks — prefer the WebUI for management.   │
# │                                                                        │
# │  • CI/CD SECRETS (Tailscale, SSH, Docker Hub, Discord)                 │
# │    → Set in GitHub repo Settings → Secrets — not in .env.              │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Port map (all bound to 127.0.0.1 — reachable via localhost / Tailscale):
#   80     nginx              3001   webui (SvelteKit)
#   5432   postgres           3000   grafana
#   6379   redis              9090   prometheus
#   7000   janus HTTP         9093   alertmanager
#   8050   ruby data API      16686  jaeger UI
#   8080   ruby web (HTMX)    3500   rc-app  (Tailscale-bound)
#   8200   trainer            5433   rc-postgres
#   8812   questdb pg wire    6380   rc-redis (Tailscale-bound)
#   9009   questdb ILP
#   6333   qdrant REST
#   6334   qdrant gRPC
# =============================================================================


# =============================================================================
# TIMEZONE & GENERAL
# =============================================================================
TZ=America/Toronto
TAILSCALE_IP=100.x.x.x          # Your Tailscale interface IP: tailscale ip -4


# =============================================================================
# POSTGRES — shared database (janus_db + ruby_db on one instance)
# =============================================================================
POSTGRES_HOST=fks_postgres
POSTGRES_PORT=5432
POSTGRES_USER=fks_user
POSTGRES_PASSWORD=               # generate: openssl rand -base64 32
JANUS_DB=janus_db             # Janus schema (signals, regime, backtest)
RUBY_DB=ruby_db         # Ruby schema (bars, journal, ORB events, tasks)

# Constructed URLs — used directly by services; keep in sync with vars above.
DATABASE_URL=postgresql://fks_user:${POSTGRES_PASSWORD}@fks_postgres:5432/janus_db


# =============================================================================
# REDIS — shared instance (namespaced by key prefix)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                  # generate: openssl rand -base64 32
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0


# =============================================================================
# QUESTDB — time-series market data
# =============================================================================
QUESTDB_HOST=fks_questdb
QUESTDB_PG_PORT=8812
QUESTDB_PG_USER=admin
QUESTDB_PG_PASSWORD=             # generate: openssl rand -base64 32
# Set to true to require HTTP Basic auth on the QuestDB web console (port 9000)
QDB_HTTP_SECURITY_ENABLED=false


# =============================================================================
# QDRANT — vector database (disabled by default; start with --profile qdrant)
# =============================================================================
# No user-configurable secrets. Qdrant listens on 6333 (REST) and 6334 (gRPC).
# Enable with: docker compose --profile qdrant up -d


# =============================================================================
# JANUS — Rust ML / neuromorphic trading engine
# HTTP API: port 7000 (host) / 8080 (container)
# gRPC:     port 9051 (host) / 50051 (container)
# =============================================================================

# --- Execution mode ---
EXECUTION_MODE=paper_trading     # paper_trading | live  — NEVER set live without full review
EXEC_ACCOUNT_TYPE=paper          # label on trade-signal alerts (paper | personal-crypto | prop)

# --- Market data ingestion ---
DATA_SOURCE=live                 # live | backtest
DATA_EXCHANGE=binance
DATA_WS_URL=wss://stream.binance.com:9443/ws
DATA_KLINE_INTERVALS=1m,5m
DATA_RECONNECT_DELAY_SECS=5
DATA_MAX_RECONNECT_ATTEMPTS=50
DATA_HEALTH_POLL_SECS=10

# --- Python data service client (Janus → Ruby) ---
DATA_CLIENT_TIMEOUT_SECS=30
DATA_CLIENT_MAX_RETRIES=3
DATA_CLIENT_RETRY_DELAY_MS=500

# --- Brain / watchdog ---
BRAIN_WIRE_KILL_SWITCH=false
BRAIN_AUTO_START_WATCHDOG=true
BRAIN_HEARTBEAT_MS=5000
BRAIN_WATCHDOG_CHECK_INTERVAL_MS=5000
BRAIN_WATCHDOG_DEAD_THRESHOLD=10

# --- Execution gate (Janus → Ruby execution_gate.py) ---
JANUS_ENABLE_BACKWARD=true
ENABLE_EXECUTION=true
# EXECUTION_ENDPOINT is hardcoded in compose: http://fks_ruby:8000/api/execute
EXECUTION_EXCHANGE=kraken
EXECUTION_CONNECT_TIMEOUT=10
EXECUTION_REQUEST_TIMEOUT=30
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_BACKOFF_MS=100
EXECUTION_DEFAULT_QUANTITY=0.001

# --- Alertmanager integration (Janus pushes trade-signal alerts) ---
ALERTMANAGER_URL=http://alertmanager:9093

# --- Optimizer ---
OPTIMIZER_ENABLED=true
OPTIMIZE_ASSETS=BTC,ETH,SOL
OPTIMIZE_INTERVAL=6h
OPTIMIZE_TRIALS=100
OPTIMIZE_HISTORICAL_DAYS=30
OPTIMIZER_INSTANCE_ID=janus-prod


# =============================================================================
# RUBY — Python trading system (data API + HTMX web + ML engine + factory)
# Data API: port 8050 (host) / 8000 (container)
# Web:      port 8080 (host) / 8080 (container)
# =============================================================================

# --- Janus back-references (Ruby calls back into Janus) ---
JANUS_GRPC_HOST=fks_janus
JANUS_GRPC_PORT=50051
JANUS_HTTP_URL=http://fks_janus:8080
JANUS_FORWARD_URL=http://janus-forward:8080

# --- Internal API keys ---
API_KEY=                         # Bearer token for Janus → Ruby data client
TRAINER_API_KEY=                 # generate: openssl rand -hex 32
NGINX_INTERNAL_TOKEN=            # generate: openssl rand -hex 32

# --- ORB gates ---
ORB_FILTER_GATE=majority
ORB_CNN_GATE=0

# --- DataFactory ---
FACTORY_ENABLED_CLASSES=futures_cme,crypto
GAP_SCAN_INTERVAL_SECS=300

# --- Backfill ---
BACKFILL_DAYS_BACK=365
BACKFILL_CHUNK_DAYS=30

# --- Paper trading / simulation ---
PAPER_TRADING_ENABLED=0
SIM_ENABLED=0
SIM_DATA_SOURCE=kraken
SIM_INITIAL_BALANCE=100000

# --- Web dashboard auth ---
# Generate hash: ./run.sh web-hash-password
# Leave empty to disable auth (Tailscale-only access is still required).
WEB_PASSWORD_HASH=
WEB_SESSION_SECRET=              # generate: openssl rand -base64 32
WEB_SESSION_TTL_DAYS=30

# --- API key encryption (Fernet master key for DB-stored credentials) ---
API_KEY_ENCRYPTION_SECRET=       # generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Audit runtime (LLM-based code analysis; optional) ---
AUDIT_RUNTIME_ENABLED=false
AUDIT_LLM_ENABLED=false
AUDIT_LLM_PROVIDER=xai
AUDIT_LLM_API_KEY=               # leave empty to use XAI_API_KEY
AUDIT_LLM_MODEL=grok-4-20


# =============================================================================
# WEBUI — SvelteKit frontend (port 3001 host / 3000 container)
# =============================================================================
NODE_ENV=production
PUBLIC_API_URL=http://fks_ruby:8000   # Ruby data API (internal Docker network)
PUBLIC_JANUS_URL=http://fks_janus:7000
ORIGIN=http://localhost:3001          # SvelteKit CSRF origin check


# =============================================================================
# TRAINER — GPU CNN retraining (--profile training, port 8200)
# Requires NVIDIA GPU + nvidia-container-toolkit on host.
# =============================================================================
TRAINER_HOST=0.0.0.0
TRAINER_PORT=8200

CNN_RETRAIN_SYMBOLS=MGC,SIL,MES,MNQ,M2K,MYM
CNN_RETRAIN_DAYS_BACK=365
CNN_RETRAIN_BARS_SOURCE=engine
CNN_RETRAIN_ORB_SESSION=all
CNN_ORB_SESSION=all

CNN_RETRAIN_EPOCHS=60
CNN_RETRAIN_BATCH_SIZE=64
CNN_RETRAIN_LR=0.0001
CNN_RETRAIN_PATIENCE=12
CNN_RETRAIN_IMPROVEMENT=0.0

CNN_RETRAIN_MIN_ACC=65.0
CNN_RETRAIN_MIN_PRECISION=55.0
CNN_RETRAIN_MIN_RECALL=50.0

ENGINE_BARS_TIMEOUT=60
ENGINE_FILL_POLL_MAX_WAIT=300
ENGINE_FILL_POLL_INTERVAL=10


# =============================================================================
# NGINX — reverse proxy
# =============================================================================
# API_KEY and NGINX_INTERNAL_TOKEN are shared with the Ruby section above.
#
# TLS certificate paths (AUTH-B).  These are substituted into
# fkstrading.local.conf by entrypoint.sh at container start.
# Generate certs with: ./run.sh gen-certs
# Defaults below match the volume mount in docker-compose.yml.
TLS_CERT_PATH=/etc/nginx/certs/server.crt
TLS_KEY_PATH=/etc/nginx/certs/server.key
TLS_CA_PATH=/etc/nginx/certs/ca.crt


# =============================================================================
# PROMETHEUS — metrics collection (port 9090)
# =============================================================================
# No user-configurable secrets. Prometheus scrapes all services automatically.


# =============================================================================
# GRAFANA — dashboards (port 3000, served at /grafana/ via nginx)
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=                # generate: openssl rand -base64 32


# =============================================================================
# ALERTMANAGER — alert routing (port 9093)
# =============================================================================
# Alertmanager config is in infrastructure/config/alertmanager/
# The Discord bridge below handles webhook delivery.


# =============================================================================
# DISCORD — alerts (alertmanager Discord bridge)
# =============================================================================
DISCORD_BOT_TOKEN=               # from Discord Developer Portal → Bot → Token
DISCORD_WEBHOOK_GENERAL=         # Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_SIGNALS=
DISCORD_WEBHOOK_ANALYSIS=
# xAI key kept for the optional Ruby audit-LLM path; safe to leave
# blank if AUDIT_LLM_ENABLED=false.
XAI_API_KEY=                     # from console.x.ai
XAI_MODEL=grok-4-fast            # grok-4-fast | grok-4 | grok-3-mini


# =============================================================================
# GITHUB — repository integration (webhook validation, sync)
# =============================================================================
GITHUB_TOKEN=                    # Personal access token (repo, read:org)
GITHUB_WEBHOOK_SECRET=           # Shared secret for webhook HMAC validation
GITHUB_USERNAME=nuniesmith
GITHUB_ORG=                      # Optional: GitHub org name


# =============================================================================
# KRAKEN — crypto spot + futures broker
# Keys managed via WebUI Settings → API Keys (encrypted in DB).
# These env vars are the fallback if no DB entry exists.
# =============================================================================
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
ENABLE_KRAKEN_CRYPTO=1


# =============================================================================
# RITHMIC — CME futures broker (prop-account gateway)
# Keys managed via WebUI Settings → API Keys (encrypted in DB).
# These env vars are the fallback if no DB entry exists.
# =============================================================================
RITHMIC_USER=
RITHMIC_PASSWORD=
RITHMIC_LIVE_DATA=0              # set to 1 to enable persistent live tick stream
RITHMIC_SYMBOLS=MES,MNQ,M2K,MYM # symbols to subscribe to when RITHMIC_LIVE_DATA=1
RITHMIC_DEBUG_LOGGING=0          # set to 1 for verbose connection logging


# =============================================================================
# MASSIVE — CME futures bar data provider
# =============================================================================
MASSIVE_API_KEY=
MASSIVE_S3_KEY_ID=
MASSIVE_S3_SECRET=
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles


# =============================================================================
# SUPPLEMENTARY MARKET DATA
# =============================================================================
FINNHUB_API_KEY=                 # from finnhub.io (news + earnings calendar)
ALPHA_VANTAGE_API_KEY=           # from alphavantage.co (supplementary OHLCV)

# --- CoinMarketCap (crypto quotes + fear/greed index; free Basic = 10K credits/mo) ---
CMC_API_KEY=
CMC_POLL_QUOTES=900
CMC_POLL_GLOBAL=1800
CMC_POLL_FEAR_GREED=1800
CMC_POLL_LISTINGS=21600

# =============================================================================
# ON-CHAIN MONITORING (all optional)
# =============================================================================
WHALE_ALERT_API_KEY=
ETHERSCAN_API_KEY=
SOLSCAN_API_KEY=
CRYPTOCOMPARE_API_KEY=
MEMPOOL_SPACE_URL=https://mempool.space/api

CHAIN_MIN_USD=1000000            # minimum USD value for whale alert filter
CHAIN_POLL_WHALE=30              # whale alert poll interval (seconds)
CHAIN_POLL_MEMPOOL=60            # mempool poll interval (seconds)
CHAIN_POLL_FLOW=3600             # on-chain flow poll interval (seconds)

# =============================================================================
# MISC
# =============================================================================
COPIER_URL=                      # optional copy-trading relay endpoint
LOG_LEVEL=info
PYTHONUNBUFFERED=1

# =============================================================================
# BUILD FROM SOURCE — Git clone refs for docker compose build
#
# When a REPO_URL is set, the base image clones from GitHub at the given ref
# instead of using the local build context. Leave empty for local dev builds.
#
# Usage:
#   docker compose build ruby          # uses local src/ruby (REPO_URL not set)
#   docker compose build ruby \
#     --build-arg REPO_URL=https://github.com/nuniesmith/ruby \
#     --build-arg REPO_REF=v1.2.0      # clones from GitHub
# =============================================================================

# Ruby (Python data + engine services)
# Leave REPO empty to build from the local src/ruby copy; set it to clone.
RUBY_REPO=                       # e.g. https://github.com/nuniesmith/ruby
RUBY_REF=main                    # branch, tag, or commit SHA

# Janus (Rust trading brain) — no local copy lives in this repo, so the
# image ALWAYS clones. Override REF to deploy a branch/tag/commit.
JANUS_REPO=https://github.com/nuniesmith/janus
JANUS_REF=main

# Bot Spawner (Rust container lifecycle manager)
# Still in-tree (crates/spawner); leave REPO empty to build locally.
SPAWNER_REPO=                    # e.g. https://github.com/nuniesmith/spawner
SPAWNER_REF=main

# Web UI (SvelteKit frontend)
WEB_REPO=                        # e.g. https://github.com/nuniesmith/fks-web
WEB_REF=main

# =============================================================================
# BOT SPAWNER
# =============================================================================
ALLOWED_BOT_IMAGE_PREFIX=fks-bot-  # only images with this prefix can be spawned
MAX_CONCURRENT_BOTS=20             # hard cap on simultaneously running bots
BOT_CPU_LIMIT=1.0                  # fractional cores per bot container
BOT_MEMORY_MB=512                  # memory cap per bot container (MiB)
BOT_PRUNE_AFTER_SECS=300           # seconds before stopped bots are auto-pruned
SPAWNER_LOG_LEVEL=info,spawner=debug
