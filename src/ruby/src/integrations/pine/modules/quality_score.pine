// ── Module: quality_score ───────────────────────────────────────────────────
// Part of the Ruby indicator — assembled by PineScriptGenerator

// ══════════════════════════════════════════════════════════════════════════════
// 9. QUALITY SCORE  (0 – 100)
// [FIX] rHigh/rLow na-guarded in ORB component — prevented false quality
//       score of +20 on pre-ORB bars when rHigh/rLow were still na.
// [FIX] Final clamp uses f_clamp() from §0b.
// ══════════════════════════════════════════════════════════════════════════════
quality = 0.0
quality += (bullBias  and ao > ao[1])         or (not bullBias and ao < ao[1])         ? 20.0 : 0.0
quality += (close > ema9 and bullBias)         or (close < ema9 and not bullBias)       ? 15.0 : 0.0
quality += (bullBias  and close > vwap)        or (not bullBias and close < vwap)       ? 20.0 : 0.0
quality += volume > volAvg * volMult                                                     ? 25.0 : 0.0
// [FIX] Explicit na guards — rHigh/rLow may be na before ORB period completes
quality += rangeReady and not na(rHigh) and not na(rLow) and
           ((bullBias and close > rHigh) or (not bullBias and close < rLow))             ? 20.0 : 0.0
quality := f_clamp(quality, 0.0, 100.0)
