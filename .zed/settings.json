{
    // ─────────────────────────────────────────────────────────────────────
    // FKS Monorepo — Zed Project Settings
    // ─────────────────────────────────────────────────────────────────────
    // Python  : ruff (format + lint), mypy type-checking, pyright disabled
    // Proto   : buf LSP, format on save
    // Python  : 3.13 via .venv/
    // ─────────────────────────────────────────────────────────────────────
    "languages": {
        "Python": {
            "language_servers": ["ruff", "!pyright"],
            "formatter": {
                "external": {
                    "command": ".venv/bin/ruff",
                    "arguments": [
                        "format",
                        "--stdin-filename",
                        "{buffer_path}",
                        "-"
                    ]
                }
            },
            "format_on_save": "on",
            "tab_size": 4
        },
        "Proto": {
            "language_servers": ["buf"],
            "format_on_save": "on"
        }
    },
    "lsp": {
        "ruff": {
            "binary": {
                "path": ".venv/bin/ruff",
                "arguments": ["server"]
            },
            "initialization_options": {
                "settings": {
                    "lineLength": 120,
                    "lint": {
                        "enable": true
                    },
                    "format": {
                        "enable": true
                    }
                }
            }
        },
        "pyright": {
            "settings": {
                "python": {
                    "pythonPath": ".venv/bin/python"
                },
                "pyright": {
                    "disableOrganizeImports": true
                }
            }
        },
        "buf": {
            "initialization_options": {
                "root": "proto"
            }
        }
    },
    "file_scan_exclusions": [
        "**/.git",
        "**/.venv",
        "**/__pycache__",
        "**/.mypy_cache",
        "**/.pytest_cache",
        "**/.ruff_cache",
        "**/node_modules",
        "**/target",
        "**/dataset/images",
        "**/generated/rust",
        "**/generated/python"
    ]
}
