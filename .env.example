# =============================================================================
# FKS Trading System — Environment Variables
# Copy to .env and fill in your values.
#
#   cp .env.example .env
#
# Generate secrets with:
#   openssl rand -base64 32   # for passwords / session secrets
#   openssl rand -hex 32      # for tokens / API keys
#
# Or use the helper script:
#   ./run.sh setup-env
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │  SECRET MANAGEMENT PHILOSOPHY                                          │
# │                                                                        │
# │  • SERVICE SECRETS (Postgres, Redis, Grafana, session keys, etc.)      │
# │    → Auto-generated by ./run.sh setup-env — never leave the server.    │
# │    → Stored ONLY in .env — never committed to git.                     │
# │                                                                        │
# │  • EXTERNAL API KEYS (Kraken, Rithmic, Massive, xAI, TV, etc.)        │
# │    → Stored encrypted in Postgres via Settings → API Keys in WebUI.    │
# │    → key_manager resolves: encrypted DB → env var → None (graceful).   │
# │    → Env vars below are fallbacks — prefer the WebUI for management.   │
# │                                                                        │
# │  • CI/CD SECRETS (Tailscale, SSH, Docker Hub, Discord)                 │
# │    → Set in GitHub repo Settings → Secrets — not in .env.              │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Port map (all bound to 127.0.0.1 — reachable via localhost / Tailscale):
#   80     nginx              3001   webui (SvelteKit)
#   5432   postgres           3000   grafana
#   6379   redis              9090   prometheus
#   7000   janus HTTP         9093   alertmanager
#   7001   janus forward      16686  jaeger UI
#   8090   bot spawner        9000   questdb console
#   8812   questdb pg wire    9091   demo bot (--profile demo)
#   9009   questdb ILP        3100   loki
#   6333   qdrant REST
#   6334   qdrant gRPC
# =============================================================================


# =============================================================================
# TIMEZONE & GENERAL
# =============================================================================
TZ=America/Toronto
TAILSCALE_IP=100.x.x.x          # Your Tailscale interface IP: tailscale ip -4

# Compose project name. Pin it so bare `docker compose ...` uses the SAME project
# as ./run.sh (which passes `-p fks`). The services set explicit container_name:
# values (globally unique), so running under two different projects collides with
# e.g. "Conflict: container name /fks_alertmanager is already in use". Keep these
# in sync; prefer ./run.sh for stack operations.
COMPOSE_PROJECT_NAME=fks

# Compose profiles. Services built from the PRIVATE sibling repo ../fks-state
# (advisor, orb-briefing) sit behind the "state" profile so a public-only
# checkout can still bring the stack up. ./run.sh auto-enables "state" when
# ../fks-state exists — you only need this for bare `docker compose` usage:
# uncomment on a host with the sibling checkout (comma-separate to combine,
# e.g. state,demo).
#COMPOSE_PROFILES=state


# =============================================================================
# POSTGRES — shared database (janus_db + fks_db on one instance)
# =============================================================================
POSTGRES_HOST=fks_postgres
POSTGRES_PORT=5432
POSTGRES_USER=fks_user
POSTGRES_PASSWORD=               # generate: openssl rand -base64 32
JANUS_DB=janus_db             # Janus schema (signals, regime, backtest)
RUBY_DB=fks_db          # Spawner schema (bot_configs, bot_runs) — var name RUBY_DB retained

# Constructed URLs — used directly by services; keep in sync with vars above.
DATABASE_URL=postgresql://fks_user:${POSTGRES_PASSWORD}@fks_postgres:5432/janus_db


# =============================================================================
# REDIS — shared instance (namespaced by key prefix)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                  # generate: openssl rand -base64 32
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0


# =============================================================================
# QUESTDB — time-series market data
# =============================================================================
QUESTDB_HOST=fks_questdb
QUESTDB_PG_PORT=8812
QUESTDB_PG_USER=admin
QUESTDB_PG_PASSWORD=             # generate: openssl rand -base64 32
# Set to true to require HTTP Basic auth on the QuestDB web console (port 9000)
QDB_HTTP_SECURITY_ENABLED=false


# =============================================================================
# QDRANT — vector database (always-on; the --profile qdrant flag is legacy)
# =============================================================================
# No user-configurable secrets. Qdrant listens on 6333 (REST) and 6334 (gRPC).
# Janus's experience store connects over gRPC via container DNS.
QDRANT_URL=http://fks_qdrant:6334
# false = a Qdrant outage is a hard error and experience batches stay parked in
# the spool until it recovers. Set true ONLY for tests: the mock "persists" to
# process memory and loses everything on restart.
QDRANT_USE_MOCK=false


# =============================================================================
# JANUS — Rust ML / neuromorphic trading engine
# HTTP API: port 7000 (host) / 8080 (container)
# gRPC:     port 9051 (host) / 50051 (container)
# =============================================================================

# --- Execution mode ---
EXECUTION_MODE=paper_trading     # paper_trading | live  — NEVER set live without full review
EXEC_ACCOUNT_TYPE=paper          # label on trade-signal alerts (paper | personal-crypto | prop)

# --- Market data ingestion ---
DATA_SOURCE=live                 # live | backtest
DATA_EXCHANGE=binance
DATA_WS_URL=wss://stream.binance.com:9443/ws
DATA_KLINE_INTERVALS=1m,5m
DATA_RECONNECT_DELAY_SECS=5
DATA_MAX_RECONNECT_ATTEMPTS=50
DATA_HEALTH_POLL_SECS=10
# Persist closed klines → QuestDB candles_crypto (the WebUI chart history
# source). On by default; set false to disable the sink.
DATA_PERSIST_CANDLES=true

# --- Brain / watchdog ---
BRAIN_WIRE_KILL_SWITCH=false
BRAIN_AUTO_START_WATCHDOG=true
BRAIN_HEARTBEAT_MS=5000
BRAIN_WATCHDOG_CHECK_INTERVAL_MS=5000
BRAIN_WATCHDOG_DEAD_THRESHOLD=10

# --- Execution gate (janus brain → broker) ---
# NEVER autonomous: signals terminate at a human decision point. Keep
# ENABLE_EXECUTION=false unless you fully understand the live order path.
JANUS_ENABLE_BACKWARD=true
ENABLE_EXECUTION=false
# Portfolio risk enforcement (janus forward). Defaults ON in compose: a
# RiskManager rejection (over-exposure / daily-loss / max-position) blocks the
# order submit. Set to 0 only to make risk checks advisory — not recommended
# when ENABLE_EXECUTION=true.
JANUS_RISK_ENFORCE=1
# EXECUTION_ENDPOINT defaults (in compose) to the janus-execution gRPC service.
EXECUTION_EXCHANGE=kraken
EXECUTION_CONNECT_TIMEOUT=10
EXECUTION_REQUEST_TIMEOUT=30
EXECUTION_MAX_RETRIES=3
EXECUTION_RETRY_BACKOFF_MS=100
EXECUTION_DEFAULT_QUANTITY=0.001

# --- Experience pipeline (forward → /dev/shm spool → backward → Qdrant) ---
# Design: janus repo docs/architecture/EXPERIENCE_PIPELINE.md. Default OFF.
# When enabled, janus forward records per-candle decisions as Arrow IPC batches
# in the spool dir and backward ingests them into Qdrant (QDRANT_* above).
JANUS_EXPERIENCE_ENABLED=false
JANUS_EXPERIENCE_SPOOL_DIR=/dev/shm/janus/experience
JANUS_EXPERIENCE_BATCH_ROWS=256    # rows per spooled Arrow batch
JANUS_EXPERIENCE_FLUSH_SECS=60     # max seconds before a partial batch flushes
JANUS_EXPERIENCE_SPOOL_MAX_MB=256  # spool cap (janus shm_size 512m sits above it)

# --- Alertmanager integration (Janus pushes trade-signal alerts) ---
ALERTMANAGER_URL=http://alertmanager:9093

# --- Optimizer ---
OPTIMIZER_ENABLED=true
OPTIMIZE_ASSETS=BTC,ETH,SOL
OPTIMIZE_INTERVAL=6h
OPTIMIZE_TRIALS=100
OPTIMIZE_HISTORICAL_DAYS=30
OPTIMIZER_INSTANCE_ID=janus-prod


# =============================================================================
# INTERNAL AUTH — shared secrets for the internal service mesh
# =============================================================================
# The Python "Ruby" data/engine/trainer services were removed (janus is the
# platform — see docs/architecture/RUST_MIGRATION.md). These two tokens are
# still used by the surviving services:
#   API_KEY              — bearer token accepted by internal HTTP APIs
#   NGINX_INTERNAL_TOKEN — shared secret nginx forwards on every proxied
#                          request; validated by the spawner (X-Internal-Token)
API_KEY=                         # generate: openssl rand -hex 32
NGINX_INTERNAL_TOKEN=            # generate: openssl rand -hex 32
# Scoped bot->spawner /events ingest token (empty = bots have no ingest path)
EVENTS_TOKEN=                    # generate: openssl rand -hex 32


# =============================================================================
# WEBUI — SvelteKit frontend (port 3001 host / 3000 container)
# =============================================================================
NODE_ENV=production
# The Ruby data API was removed; the dashboard's API base points at janus.
# A janus-native data contract for the WebUI is tracked in RUST_MIGRATION.md.
PUBLIC_API_URL=http://fks_janus:7000
PUBLIC_JANUS_URL=http://fks_janus:7000
ORIGIN=http://localhost:3001          # SvelteKit CSRF origin check
# D1 live-bars bridge: when set, the adapter pipes /sse/bars/:sym straight
# through to janus's bars SSE stream (event: bar frames). Leave unset to keep
# the graceful idle stub. Requires a janus image with GET /sse/bars/{symbol}.
# JANUS_BARS_SSE_URL=http://fks_janus:8080/sse/bars


# =============================================================================
# NGINX — reverse proxy
# =============================================================================
# API_KEY and NGINX_INTERNAL_TOKEN are set in the INTERNAL AUTH section above.
#
# TLS certificate paths (AUTH-B).  These are substituted into
# fkstrading.local.conf by entrypoint.sh at container start.
# Generate certs with: ./run.sh gen-certs
# Defaults below match the volume mount in docker-compose.yml.
TLS_CERT_PATH=/etc/nginx/certs/server.crt
TLS_KEY_PATH=/etc/nginx/certs/server.key
TLS_CA_PATH=/etc/nginx/certs/ca.crt


# =============================================================================
# PROMETHEUS — metrics collection (port 9090)
# =============================================================================
# No user-configurable secrets. Prometheus scrapes all services automatically.


# =============================================================================
# GRAFANA — dashboards (port 3000, served at /grafana/ via nginx)
# =============================================================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=                # generate: openssl rand -base64 32
# Grafana anonymous (logged-out) read access. DEFAULT false since 2026-08-22.
# It was true/Viewer, which left 18 dashboards — including net worth and P&L —
# readable with no credentials on :3000 and through nginx at /grafana/. The
# "single-user tailnet" premise behind that is false: 8 owning accounts across
# ~20 devices. Set true only if you deliberately want logged-out dashboards.
GRAFANA_ANONYMOUS=false


# =============================================================================
# ALERTMANAGER — alert routing (port 9093)
# =============================================================================
# Alertmanager config is in infrastructure/config/alertmanager/
# The Discord bridge below handles webhook delivery.


# =============================================================================
# DISCORD — alerts (alertmanager Discord bridge)
# =============================================================================
DISCORD_BOT_TOKEN=               # from Discord Developer Portal → Bot → Token
DISCORD_WEBHOOK_GENERAL=         # Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_SIGNALS=
DISCORD_WEBHOOK_ANALYSIS=

# Webhook used by the `state`-profile services (advisor daily/weekly digests +
# orb-briefing pre-market/day-plan messages — built from ../fks-state). Their
# schedules default in compose (ADVISOR_DAILY_TIME=17:30, ADVISOR_WEEKLY="Sun
# 18:00", ORB_BRIEFING_TIME=08:30, ORB_PLAN_TIME=10:00 ET; ORB_* sizing knobs
# likewise) — override here only if you need different times/limits.
DISCORD_WEBHOOK=


# =============================================================================
# DEAD-MAN'S SWITCH — external "is oryx alive at all?" heartbeat
# =============================================================================
# Every alert above dies with the box. The `deadman` service GETs this URL
# every 60s; the HOSTED check (healthchecks.io or similar) pages when pings
# STOP. Leave empty to disable the pinger (it idles silently).
# Setup: docs/infrastructure/DEADMAN_SWITCH.md
DEADMAN_PING_URL=                # e.g. https://hc-ping.com/<check-uuid> — treat as a secret
# DEADMAN_INTERVAL_SECS=60       # ping cadence; default 60, rarely needs changing


# =============================================================================
# KRAKEN — crypto spot + futures broker
# Keys managed via WebUI Settings → API Keys (encrypted in DB); these env vars
# are the fallback. The crypto-demo bot's LIVE mode (DEMO_EXCHANGE=kraken →
# Kraken SPOT, long-only) reads KRAKEN_API_KEY / KRAKEN_API_SECRET directly.
# =============================================================================
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
ENABLE_KRAKEN_CRYPTO=1

# =============================================================================
# KUCOIN — crypto spot + futures broker
# Keys managed via WebUI Settings → API Keys (encrypted in DB); these env vars
# are the fallback. The crypto-demo bot's LIVE mode (DEMO_EXCHANGE=kucoin →
# KuCoin FUTURES, 5×) also uses these — compose bridges KUCOIN_API_* → the
# bot's KC_* vars, so you maintain one set here. KuCoin retired its public
# sandbox, so a "demo" = a sub-account funded with the minimum, traded tiny.
# Leave empty to stay on the paper MockExchange.
# =============================================================================
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSPHRASE=
ENABLE_KUCOIN_CRYPTO=0


# =============================================================================
# RITHMIC — CME futures broker (prop-account gateway)
# Keys managed via WebUI Settings → API Keys (encrypted in DB).
# These env vars are the fallback if no DB entry exists.
# =============================================================================
RITHMIC_USER=
RITHMIC_PASSWORD=
# The ACCOUNT TRIPLE — required for READ-ONLY position visibility (GET /positions).
# `positions_ready()` needs all three non-empty; with any one missing the PnL-plant
# subscription is skipped SILENTLY (market data still flows, the connector still
# reports healthy, and /positions just returns nothing — which reads as "flat"
# rather than "never subscribed"). Issued by the FCM / prop firm with the login.
RITHMIC_ACCOUNT_ID=             # the account to read (e.g. the prop evaluation acct)
RITHMIC_FCM_ID=                 # clearing firm id
RITHMIC_IB_ID=                  # introducing broker id
#
# REMOVED 2026-08-22: RITHMIC_LIVE_DATA / RITHMIC_SYMBOLS / RITHMIC_DEBUG_LOGGING.
# NOTHING read them — grep the tree, there is no consumer. They were worse than
# dead: "RITHMIC_SYMBOLS=MES,MNQ,M2K,MYM  # symbols to subscribe to" invites you
# to configure four instruments, and the connector subscribes to exactly ONE
# (RITHMIC_INSTRUMENT, singular — one `.subscribe()` call in connector.rs). To
# cover several contracts, run one connector container per instrument, and check
# your Rithmic app credential's concurrent-connection limit first.
# The real controls are RITHMIC_ENABLED (gate) and RITHMIC_INSTRUMENT (symbol);
# verbosity is RITHMIC_LOG_LEVEL.

# ── rithmic-connector service (READ-ONLY futures feed, `rithmic` profile) ────
# Doubly gated: only runs under `docker compose --profile rithmic` AND when
# RITHMIC_ENABLED=true with credentials present. Lives in the PRIVATE sibling
# repo: fks-state:crates/rithmic-connector (built from ../fks-state).
RITHMIC_ENABLED=false           # master runtime gate; nothing connects unless true
RITHMIC_ENV=demo                # demo | test | live
RITHMIC_GATEWAY_URL=            # wss://… gateway issued by Rithmic after onboarding
RITHMIC_GATEWAY_ALT_URL=        # beta/alt URL (defaults to the primary)
RITHMIC_SYSTEM_NAME=            # e.g. "Rithmic Test" (3rd broker secret slot)
RITHMIC_INSTRUMENT=MES          # the single instrument this connector subscribes
RITHMIC_EXCHANGE=CME            # its exchange (→ candles_futures.exchange column)
# QuestDB ILP endpoint for candles_futures writes (defaults to in-network questdb):
QUESTDB_ILP_HOST=fks_questdb
QUESTDB_ILP_PORT=9009
QUESTDB_ILP_URL=                # host:port override (optional; scheme stripped)


# =============================================================================
# MASSIVE — CME futures bar data provider
# =============================================================================
MASSIVE_API_KEY=
MASSIVE_S3_KEY_ID=
MASSIVE_S3_SECRET=
MASSIVE_S3_ENDPOINT=https://files.massive.com
MASSIVE_S3_BUCKET=flatfiles


# =============================================================================
# SUPPLEMENTARY MARKET DATA
# =============================================================================
FINNHUB_API_KEY=                 # from finnhub.io (news + earnings calendar)
ALPHA_VANTAGE_API_KEY=           # from alphavantage.co (supplementary OHLCV)

# --- CoinMarketCap (crypto quotes + fear/greed index; free Basic = 10K credits/mo) ---
CMC_API_KEY=
CMC_POLL_QUOTES=900
CMC_POLL_GLOBAL=1800
CMC_POLL_FEAR_GREED=1800
CMC_POLL_LISTINGS=21600

# =============================================================================
# ON-CHAIN MONITORING (all optional)
# =============================================================================
WHALE_ALERT_API_KEY=
ETHERSCAN_API_KEY=
SOLSCAN_API_KEY=
CRYPTOCOMPARE_API_KEY=
MEMPOOL_SPACE_URL=https://mempool.space/api

CHAIN_MIN_USD=1000000            # minimum USD value for whale alert filter
CHAIN_POLL_WHALE=30              # whale alert poll interval (seconds)
CHAIN_POLL_MEMPOOL=60            # mempool poll interval (seconds)
CHAIN_POLL_FLOW=3600             # on-chain flow poll interval (seconds)

# =============================================================================
# MISC
# =============================================================================
COPIER_URL=                      # optional copy-trading relay endpoint
LOG_LEVEL=info
PYTHONUNBUFFERED=1

# =============================================================================
# BUILD FROM SOURCE — Git clone refs for docker compose build
#
# When a REPO_URL is set, the base image clones from GitHub at the given ref
# instead of using the local build context. Leave empty for local dev builds.
#
# Usage:
#   docker compose build janus         # always clones (no local janus copy)
#   docker compose build webui \
#     --build-arg REPO_URL=https://github.com/nuniesmith/fks-web \
#     --build-arg REPO_REF=v1.2.0      # clones from GitHub
# =============================================================================

# Janus (Rust trading brain) — no local copy lives in this repo, so the
# image ALWAYS clones. Override REF to deploy a branch/tag/commit.
JANUS_REPO=https://github.com/nuniesmith/janus
JANUS_REF=main

# Bot Spawner (Rust container lifecycle manager) — lives in its own repo
# (fks-spawner) since the #196 prune; there is NO in-tree copy, so the image
# ALWAYS clones (an empty REPO would try the local context and fail).
SPAWNER_REPO=https://github.com/nuniesmith/fks-spawner
SPAWNER_REF=main

# Web UI (SvelteKit frontend) — pulled from its own repo, same as JANUS above.
# The in-tree src/web is a dev fallback; set WEB_REPO empty + edit the compose
# default to build it locally instead.
WEB_REPO=https://github.com/nuniesmith/fks-web
WEB_REF=main

# =============================================================================
# BOT SPAWNER
# =============================================================================
# Host 'docker' group GID — the spawner joins it (group_add) to reach
# /var/run/docker.sock. Host-specific; `./run.sh setup-env` auto-detects it from
# `getent group docker`. Set manually only if that fails.
DOCKER_GID=
ALLOWED_BOT_IMAGE_PREFIX=fks-bot-  # only images with this prefix can be spawned
MAX_CONCURRENT_BOTS=20             # hard cap on simultaneously running bots
BOT_CPU_LIMIT=1.0                  # fractional cores per bot container
BOT_MEMORY_MB=512                  # memory cap per bot container (MiB)
BOT_PRUNE_AFTER_SECS=300           # seconds before stopped bots are auto-pruned
SPAWNER_LOG_LEVEL=info,spawner=debug

# Per-bot net-worth mark cadence, `bot_id=seconds[,bot_id=seconds…]`
# (fks-spawner #49). The sampler refuses a reading older than 2x the bot's
# cadence; a bot NOT listed here uses the global sample interval, so this is
# opt-in and can only ever LOOSEN the bot it names — an unknown bot_id falls
# back to the tighter default, never to another bot's override.
#
# `crypto-funding=3600` is REQUIRED on this host: that bot marks its positions
# on HOURLY candles (granularity=60min in funding.toml), so its mark age is a
# sawtooth up to ~3600s. Under the flat 600s tolerance it was refused ~50 min
# of every hour — measured 33 of 40 samples over-tolerance — which left the
# treasury series recording only 2-3 rows/hour and
# NetWorthSamplingPausedTooLong firing permanently (alert-blindness). With the
# override: 13 rows/hour at a uniform 5.0-min gap, zero refusals, alert clear.
# Drop this line on a rebuild and that regression comes back silently.
NET_WORTH_BOT_CADENCE_SECS=crypto-funding=3600

# Fail closed (spawner refuses to boot) when NGINX_INTERNAL_TOKEN is unset,
# instead of the silent dev passthrough. Off by default; turn on for prod.
REQUIRE_INTERNAL_TOKEN=false

# Weekly edge-decay scheduler: re-runs every active edge's backtest (edges
# with a backtest_image in the edge factory) so the Sunday advisor report can
# show drift vs the prior run. Default OFF. Schedule is UTC; the default is
# Sun 16:00 (~6h before the Sun 18:00 ET advisor report). Needs
# BACKTEST_DB_PASSWORD (below) so backtest containers get the scoped role.
EDGE_DECAY_ENABLED=false
EDGE_DECAY_WEEKDAY=0               # 0 = Sunday
EDGE_DECAY_HOUR_UTC=16
EDGE_DECAY_MINUTE_UTC=0

# Password for the SCOPED fks_backtest Postgres role handed to one-shot factory
# backtest containers via BACKTEST_DB_URL (SELECT + UPDATE(status,results,
# finished_at) on backtest_runs ONLY — never fks_user's full fks_db access).
# Role + grants: src/sql/spawner/009_backtest_role.sql (baked into the postgres
# image as 32-backtest-role.sql; on an EXISTING volume apply it by hand — see
# the script header). Generate: openssl rand -base64 32
BACKTEST_DB_PASSWORD=

# Password for the SCOPED fks_funding Postgres role handed to the private
# crypto-futures FUNDING bot via FR_DATABASE_URL (SELECT/INSERT/UPDATE/DELETE on
# only its four self-owned tables — framework_risk_state, funding_open_trades,
# funding_paper_records, funding_kill_switch — never fks_user's full fks_db
# access to exchange_secrets/treasury/webui_*). Review H1: swaps the funding bot
# off the fks_user SUPERUSER URL. Role + grants: src/sql/spawner/014_funding_state.sql
# (baked into the postgres image as 37-funding-state.sql; on an EXISTING volume
# apply it by hand — see the script header). Must equal the bot's FR_DATABASE_URL
# password. Generate: openssl rand -base64 32
FUNDING_DB_PASSWORD=

# ── P0.6 read-only treasury nodes (idle until you fill these in) ──────────────
# Cold-BTC watcher: give it an xpub (BIP84 zpub/native-segwit) OR explicit
# addresses; it derives receive+change, sums confirmed balances via Esplora,
# and records net worth under BTC_WATCH_ACCOUNT_ID. Empty = watcher stays off.
BTC_WATCH_XPUB=
BTC_WATCH_ADDRESSES=              # comma-separated; alternative to the xpub
BTC_WATCH_ACCOUNT_ID=btc-cold
BTC_WATCH_GAP=20                  # address-gap limit; deeper wallets need more
BTC_WATCH_INTERVAL_SECS=3600
ESPLORA_API_BASE=                 # override the default public Esplora endpoint
# Rithmic balance sampler: point at the rithmic-connector's /positions
# (RITHMIC_SAMPLER_URL) to record the funded account's balance. Empty = off.
RITHMIC_SAMPLER_URL=
RITHMIC_SAMPLE_INTERVAL_SECS=300
